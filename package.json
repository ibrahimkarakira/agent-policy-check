{
  "name": "agent-policy-check",
  "version": "0.0.1",
  "description": "Check that your Claude Code, Codex and MCP config really enforces your limits; says unverifiable where it cannot.",
  "license": "Apache-2.0",
  "author": "Ibrahim Karakira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimkarakira/agent-policy-check.git"
  },
  "type": "module",
  "bin": {
    "agent-policy-check": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "claude-code",
    "codex",
    "mcp",
    "agent-security",
    "policy",
    "audit",
    "lint",
    "permissions"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "node scripts/check.mjs",
    "check:linux": "node scripts/check.mjs --linux"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
